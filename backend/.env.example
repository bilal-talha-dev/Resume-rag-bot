GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000
DEBUG=True

# --- PostgreSQL + pgvector configuration ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_db
# Or configure individual fields (also editable in rag_config.yaml):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=rag_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# RAG_STORE=pgvector          # pgvector | chroma | memory
 
# --- Optional (everything else is configured in rag_config.yaml) ---
# RAG_EMBEDDER=auto            # auto | gemini | local
# RAG_RESUMES_DIR=resumes
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
